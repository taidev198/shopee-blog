# Postgres connection string (Neon / Supabase / Render Postgres / Vercel Postgres).
# Leave empty locally to use the embedded dev database in ./.data
DATABASE_URL=

# Long random string used to sign login cookies:  openssl rand -base64 32
AUTH_SECRET=

# Comma-separated emails that get the /admin page and always have full access
ADMIN_EMAIL=you@example.com

# Payment landing page
COURSE_PRICE=499000
PGLITE_DIR=
